# @name api/bulkImports/import
POST {{SBC_HostAddress}}/api/bulkImports
Authorization: Bearer {{auth_token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="Asientos.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./Asientos.xlsx
--WebAppBoundary--

